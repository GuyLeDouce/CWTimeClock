{
  "name": "cedar-winds-timeclock",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit.test.ts tests/email.test.ts tests/offline.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "NODE_OPTIONS='--conditions=react-server' tsx prisma/seed.ts",
    "db:owner-reset": "NODE_OPTIONS='--conditions=react-server' tsx prisma/reset-owner.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "retention": "NODE_OPTIONS='--conditions=react-server' tsx scripts/retention.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "csv-parse": "7.0.2",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "next": "16.3.5",
    "nodemailer": "10.0.10",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
